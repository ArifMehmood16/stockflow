# Copy to .env (ignored by Git). Use an EXISTING database on your local server.
# Accepted schemes: postgresql:// and postgresql+psycopg://. URL-encode credentials.
DATABASE_URL=postgresql+psycopg://postgres:CHANGE_ME@localhost:5432/YOUR_DATABASE
# Upper limit: use all available valid unique products if fewer exist.
DATASET_ROWS=10000000
# Optional explicit writable run size; omit for the small correctness fixture.
# FIXTURE_ROWS=1000000
# FIXTURE_SEED=stockflow-demo
# Docker creates its OWN stockflow database; the local DATABASE_URL is never used.
# This default is only for the isolated local lab; its database port is not published.
STOCKFLOW_DB_PASSWORD=stockflow-local-only
